# ── Storage ──────────────────────────────────────────────────────────────────
# Where project data (JSON) and uploaded photos are stored on disk.
# Defaults shown below — override only if you need them elsewhere
# (e.g. a mounted persistent volume). Both are created automatically.
# DATA_DIR=./data
# UPLOADS_DIR=./uploads

# ── Admin login ────────────────────────────────────────────────────────────────
# The password the client uses to log in to /admin/login
ADMIN_PASSWORD=choose-a-strong-password-here

# ── Session signing ────────────────────────────────────────────────────────────
# A random secret used to sign login cookies — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-char-random-hex-string

# ── Server ─────────────────────────────────────────────────────────────────────
# Uncomment/change if your host requires a specific port or bind address.
# HOST=0.0.0.0
# PORT=4321
