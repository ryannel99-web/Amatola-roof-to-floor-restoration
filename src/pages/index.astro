---
import Layout from '../layouts/Layout.astro';

// Master Builders Association East Cape member since 6 October 1998 (cert. no. 3071)
const MBA_SINCE = new Date('1998-10-06');
const now = new Date();
const memberYears =
  now.getFullYear() - MBA_SINCE.getFullYear() -
  (now < new Date(now.getFullYear(), MBA_SINCE.getMonth(), MBA_SINCE.getDate()) ? 1 : 0);

// Photo strip between the stats and How It Works.
// To change a photo, replace the file in public/images (keep the same name).
// `grow` sets the relative width so the strip reads as a collage.
const collage = [
  { src: '/images/collage-1.jpg', alt: 'Roof restoration project', grow: 'grow-[3]' },
  { src: '/images/collage-2.jpg', alt: 'Completed home exterior', grow: 'grow-[2]' },
  { src: '/images/collage-3.jpg', alt: 'Interior painting project', grow: 'grow-[3]' },
  { src: '/images/collage-4.jpg', alt: 'Modern home exterior', grow: 'grow-[2]' },
  { src: '/images/collage-5.jpg', alt: 'Waterproofing project', grow: 'grow-[3]' },
];
---

<Layout title="AMATOLA Roof to Floor Restorers | Residential Specialists" activePage="home">

  <!-- ── Hero ───────────────────────────────────────────── -->
  <header class="relative min-h-[700px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero.jpg"
        alt="Premium residential roofing in East London"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-deep-earth/90 via-deep-earth/40 to-transparent"></div>
    </div>


    <!-- MBA membership seal (laptop+: top-right corner) -->
    <a href="/about#accreditation" aria-label="View our Master Builders Association membership" class="hidden lg:flex absolute z-10 top-10 right-16 flex-col items-center transition-transform duration-300 hover:scale-105">
      <img
        src="/images/mba-logo.png"
        alt="Master Builders Association East Cape member"
        width="200"
        height="200"
        class="w-48 h-48 rounded-full bg-white ring-4 ring-white shadow-2xl"
      />
      <p class="mt-4 text-deep-earth bg-white/85 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-label-md uppercase tracking-wider shadow">
        Registered since 1998
      </p>
    </a>

    <div class="relative z-10 max-w-container-max mx-auto px-gutter w-full py-20">
      <div class="max-w-2xl space-y-6">
        <!-- MBA membership seal (phone/tablet: above the headline) -->
        <div class="lg:hidden flex items-center gap-3">
          <img
            src="/images/mba-logo.png"
            alt="Master Builders Association East Cape member"
            width="64"
            height="64"
            class="w-16 h-16 rounded-full bg-white ring-2 ring-white shadow-lg shrink-0"
          />
          <p class="text-warm-cream text-xs uppercase tracking-wider">MBA registered<br />since 1998</p>
        </div>
        <p class="text-warm-cream font-label-md text-label-md tracking-[0.2em] uppercase">
          Trusted Residential Specialists · East London &amp; Surrounds
        </p>
        <h1 class="text-on-primary font-display-lg text-display-lg-mobile md:text-display-lg leading-tight">
          Your Home, Restored<br />to Its Best
        </h1>
        <p class="text-warm-cream/90 font-body-lg text-body-lg leading-relaxed max-w-xl">
          Expert roofing, waterproofing, painting, alterations and floor
          restoration — done right, the first time.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <a
            href="/quote"
            class="bg-brick-red text-on-primary px-8 py-4 rounded-lg font-label-md text-label-md hover:bg-terracotta shadow-lg transition-all active:scale-95 text-center"
          >
            Get a Free Quote
          </a>
          <a
            href="/services"
            class="border-2 border-on-primary text-on-primary px-8 py-4 rounded-lg font-label-md text-label-md hover:bg-on-primary/10 transition-all text-center"
          >
            View Our Services
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- ── Services Strip ─────────────────────────────────── -->
  <section class="bg-warm-cream py-section-gap-mobile md:py-section-gap">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="mb-12">
        <h2 class="font-headline-lg text-headline-lg text-deep-earth text-center md:text-left">What We Do</h2>
        <div class="w-20 h-1 bg-brick-red mt-4 mx-auto md:mx-0"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Roofing -->
        <div class="bg-white p-8 rounded-lg border-t-4 border-brick-red shadow-sm hover:-translate-y-2 transition-transform duration-300">
          <h3 class="font-headline-md text-headline-md text-deep-earth mb-3">Roofing</h3>
          <p class="text-on-surface-variant font-body-md text-body-md">New installations, re-roofing, repairs and full roof replacements</p>
        </div>

        <!-- Waterproofing -->
        <div class="bg-white p-8 rounded-lg border-t-4 border-brick-red shadow-sm hover:-translate-y-2 transition-transform duration-300">
          <h3 class="font-headline-md text-headline-md text-deep-earth mb-3">Waterproofing</h3>
          <p class="text-on-surface-variant font-body-md text-body-md">Protecting your home from leaks and moisture damage</p>
        </div>

        <!-- Painting -->
        <div class="bg-white p-8 rounded-lg border-t-4 border-brick-red shadow-sm hover:-translate-y-2 transition-transform duration-300">
          <h3 class="font-headline-md text-headline-md text-deep-earth mb-3">Painting</h3>
          <p class="text-on-surface-variant font-body-md text-body-md">Interior and exterior painting for a fresh, lasting finish</p>
        </div>

        <!-- Alterations -->
        <div class="bg-white p-8 rounded-lg border-t-4 border-brick-red shadow-sm hover:-translate-y-2 transition-transform duration-300">
          <h3 class="font-headline-md text-headline-md text-deep-earth mb-3">Alterations</h3>
          <p class="text-on-surface-variant font-body-md text-body-md">Structural home alterations and additions to suit your lifestyle</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stats Band ─────────────────────────────────────── -->
  <section class="bg-deep-earth py-section-gap-mobile md:py-section-gap text-on-primary">
    <div class="max-w-container-max mx-auto px-gutter">
      <p class="text-warm-cream font-label-md text-label-md tracking-[0.2em] uppercase text-center mb-12">
        Amatola by the numbers
      </p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-6 text-center">
        <div class="lg:border-r border-white/10 px-4">
          <p class="font-display-lg text-display-lg-mobile md:text-display-lg text-brick-red leading-none">
            <span data-count={memberYears}>{memberYears}</span>
          </p>
          <p class="mt-3 font-headline-md text-lg">Years in business</p>
          <p class="mt-1 opacity-60 text-sm">MBA East Cape member since 1998</p>
        </div>

        <!-- TODO: confirm real number of homes with Derek -->
        <div class="lg:border-r border-white/10 px-4">
          <p class="font-display-lg text-display-lg-mobile md:text-display-lg text-brick-red leading-none">
            <span data-count="500">500</span>+
          </p>
          <p class="mt-3 font-headline-md text-lg">Homes restored</p>
          <p class="mt-1 opacity-60 text-sm">Roofs, walls and floors</p>
        </div>

        <div class="lg:border-r border-white/10 px-4">
          <p class="font-display-lg text-display-lg-mobile md:text-display-lg text-brick-red leading-none">
            <span data-count="5">5</span>
          </p>
          <p class="mt-3 font-headline-md text-lg">Trades, one team</p>
          <p class="mt-1 opacity-60 text-sm">No juggling contractors</p>
        </div>

        <div class="px-4">
          <p class="font-display-lg text-display-lg-mobile md:text-display-lg text-brick-red leading-none">
            R0
          </p>
          <p class="mt-3 font-headline-md text-lg">For your quote</p>
          <p class="mt-1 opacity-60 text-sm">Free and no obligation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Photo Collage Strip ────────────────────────────── -->
  <section aria-label="Recent work" class="bg-deep-earth">
    <div class="flex gap-1 h-56 md:h-72 overflow-x-auto md:overflow-hidden snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {collage.map((photo) => (
        <div class={`group relative shrink-0 w-[70vw] md:w-auto md:shrink md:basis-0 ${photo.grow} overflow-hidden snap-start`}>
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-deep-earth/10 group-hover:bg-transparent transition-colors duration-500"></div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── How It Works ───────────────────────────────────── -->
  <section class="bg-white py-section-gap-mobile md:py-section-gap">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="mb-16 text-center">
        <h2 class="font-headline-lg text-headline-lg text-deep-earth">How It Works</h2>
        <div class="w-20 h-1 bg-brick-red mt-4 mx-auto"></div>
        <p class="mt-6 text-on-surface-variant font-body-lg text-body-lg max-w-xl mx-auto">
          From your first call to the final walk-through, here's what to expect.
        </p>
      </div>

      <ol class="relative grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-6">
        <!-- connecting line (desktop) -->
        <div class="hidden md:block absolute top-7 left-[12.5%] right-[12.5%] h-0.5 bg-brick-red/20" aria-hidden="true"></div>

        <li class="relative text-center">
          <div class="relative z-10 w-14 h-14 mx-auto rounded-full bg-brick-red text-on-primary flex items-center justify-center font-headline-md text-xl shadow-md">1</div>
          <h3 class="mt-6 font-headline-md text-headline-md text-deep-earth">Get in touch</h3>
          <p class="mt-3 text-on-surface-variant font-body-md text-body-md leading-relaxed">
            <a href="tel:0827842112" class="text-brick-red font-semibold hover:underline">Call</a> or
            <a href="https://wa.me/27827842112" target="_blank" rel="noopener" class="text-brick-red font-semibold hover:underline">WhatsApp</a>
            us and tell us what's going on with your home.
          </p>
        </li>

        <li class="relative text-center">
          <div class="relative z-10 w-14 h-14 mx-auto rounded-full bg-brick-red text-on-primary flex items-center justify-center font-headline-md text-xl shadow-md">2</div>
          <h3 class="mt-6 font-headline-md text-headline-md text-deep-earth">Free assessment</h3>
          <p class="mt-3 text-on-surface-variant font-body-md text-body-md leading-relaxed">
            We visit, inspect the problem properly and give you a clear quote. No obligation.
          </p>
        </li>

        <li class="relative text-center">
          <div class="relative z-10 w-14 h-14 mx-auto rounded-full bg-brick-red text-on-primary flex items-center justify-center font-headline-md text-xl shadow-md">3</div>
          <h3 class="mt-6 font-headline-md text-headline-md text-deep-earth">We do the work</h3>
          <p class="mt-3 text-on-surface-variant font-body-md text-body-md leading-relaxed">
            Our own experienced team gets it done, treating your home like our own.
          </p>
        </li>

        <li class="relative text-center">
          <div class="relative z-10 w-14 h-14 mx-auto rounded-full bg-brick-red text-on-primary flex items-center justify-center font-headline-md text-xl shadow-md">4</div>
          <h3 class="mt-6 font-headline-md text-headline-md text-deep-earth">Final walk-through</h3>
          <p class="mt-3 text-on-surface-variant font-body-md text-body-md leading-relaxed">
            We check the finished job together, and leave your home clean and tidy.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Brand Quote Band ───────────────────────────────── -->
  <section class="bg-warm-cream py-16 border-y border-sand-stone/20">
    <div class="max-w-3xl mx-auto px-gutter text-center">
      <h3 class="font-headline-lg text-headline-lg text-deep-earth mb-6">
        "We work in your home. We treat it like our own."
      </h3>
      <p class="text-on-surface-variant font-body-lg text-body-lg leading-relaxed italic">
        Amatola Roof to Floor Restorers is a proudly South African company serving residential
        homeowners across the Eastern Cape. From a leaking roof to a full exterior repaint —
        we handle it all with care and professionalism.
      </p>
    </div>
  </section>

  <!-- ── Contact / Quote CTA ────────────────────────────── -->
  <section class="bg-brick-red py-section-gap-mobile md:py-section-gap relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-32 -mt-32"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-black/5 rounded-full -ml-48 -mb-48"></div>

    <div class="max-w-container-max mx-auto px-gutter relative z-10 text-center text-on-primary">
      <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-4">
        Ready to Get Started?
      </h2>
      <p class="font-headline-md text-headline-md opacity-90 mb-12">
        Contact us today for a free, no-obligation quote.
      </p>

      <div class="flex flex-col md:flex-row justify-center items-center gap-12 mb-12">
        <div class="flex items-center gap-4">
          <span class="material-symbols-outlined text-3xl">phone_in_talk</span>
          <div class="text-left">
            <p class="font-label-md text-label-md uppercase opacity-70">Call Us</p>
            <p class="text-xl font-bold"><a href="tel:0827842112" class="hover:underline">082 784 2112</a> | <a href="tel:0437400760" class="hover:underline">043 740 0760</a></p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <span class="material-symbols-outlined text-3xl">mail</span>
          <div class="text-left">
            <p class="font-label-md text-label-md uppercase opacity-70">Email Us</p>
            <p class="text-xl font-bold"><a href="mailto:admin@arfr.co.za" class="hover:underline">admin@arfr.co.za</a></p>
          </div>
        </div>
      </div>

      <a
        href="/quote"
        class="inline-block bg-white text-brick-red px-12 py-5 rounded-lg font-headline-md text-headline-md hover:bg-warm-cream transition-all shadow-xl active:scale-95"
      >
        Request a Quote
      </a>
    </div>
  </section>

</Layout>

<script>
  // Count stats up from 0 the first time they scroll into view
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = Number(el.dataset.count);
        const start = performance.now();
        const duration = 1400;
        const tick = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
        observer.unobserve(el);
      });
    }, { threshold: 0.5 });
    counters.forEach((el) => observer.observe(el));
  }
</script>
